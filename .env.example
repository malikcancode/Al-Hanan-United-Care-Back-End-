# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/alhanna

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account (used by: npm run seed)
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# CORS: the website origin, plus any other origins (admin) comma-separated
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3001

# Website cache refresh (must match REVALIDATE_SECRET in frontend/.env)
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-random-string

# Email notifications (GoDaddy Professional Email powered by Titan)
# Port 465 = SSL; 587 or 3535 = STARTTLS. Wrap the password in "double quotes" if it has symbols.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hr@alhannaunitedcare.site
SMTP_PASS=
MAIL_TO=hr@alhannaunitedcare.site
MAIL_FROM_NAME="Al Hanna Website"
SMTP_DEBUG=false
# Optional: link to the admin panel shown at the bottom of each email
ADMIN_URL=http://localhost:3001

# Spam protection for the public forms (per IP)
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW_MINUTES=15

# Set to 1 when running behind a reverse proxy / hosting platform
# TRUST_PROXY=1
